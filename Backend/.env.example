# Backend Environment Variables (Flask + DeepFace + MongoDB + Cloudinary)
# Copy this to Backend/.env for local development
# For Render deployment, configure these in the Render Dashboard under 'Environment':

# Flask Secret Key (random string for signing session/auth tokens)
FLASK_SECRET_KEY=replace_with_a_secure_random_key

# Admin Secret Key (required for enrolling/registering as ADMIN)
ADMIN_SECRET_KEY=admin123

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/face_recognition_db?retryWrites=true&w=majority
MONGO_CONNECTION_STRING=your_mongodb_connection_string_here

# Cloudinary Credentials (for profile photo CDN hosting)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Face Recognition Settings
MATCH_THRESHOLD=0.3
FACE_MODEL=Facenet512
FACE_DETECTOR=retinaface
ENFORCE_DETECTION=true
EMBEDDING_TIMEOUT_SECONDS=180

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins, or '*' to allow all.
# Example for production: https://forensight.vercel.app,https://*.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.vercel.app

# Port (Render injects $PORT automatically, defaults to 8000 locally)
PORT=8000
